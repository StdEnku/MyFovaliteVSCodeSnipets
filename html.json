{
  "HTML Boilerplate with Dark CSS": {
    "prefix": "!!!",
    "body": [
      "<!DOCTYPE html>",
      "",
      "<html>",
      "    <head>",
      "        <meta charset=\"UTF-8\">",
      "        <title>${1:Document}</title>",
      "        <!-- #region style -->",
      "        <style>",
      "            :root {",
      "                --primary-background: #121214;",
      "                --primary-text: #ededed;",
      "                --secondary-background: #1a1a1e;",
      "                --secondary-text: #9ba1a6;",
      "                --card-background: #21212646;",
      "            }",
      "",
      "            body {",
      "                background-color: var(--primary-background);",
      "                color: var(--primary-text);",
      "            }",
      "",
      "            .card {",
      "                background-color: var(--card-background);",
      "                border-radius: 10px;",
      "                backdrop-filter: blur(10px);",
      "                margin: 1px;",
      "                padding: 1px;",
      "            }",
      "",
      "            .large-content {",
      "                text-align: center; ",
      "                margin-top: 150px; ",
      "                font-size: 100px;",
      "                padding: 50px;",
      "            }",
      "        </style>",
      "        <!-- #endregion -->",
      "    </head>",
      "",
      "    <body>",
      "        <div class=\"large-content card\">",
      "            <p>${2:Hello World!!!}</p>",
      "        </div>",
      "    </body>",
      "</html>",
      "$0"
    ],
    "description": "ダークテーマのスタイルとカードコンポーネントを含むHTMLのテンプレート"
  }
}
